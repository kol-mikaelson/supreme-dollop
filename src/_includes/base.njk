<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'Software engineer. Building things with care.' }}">
  <meta property="og:title" content="{{ title or 'Kol Mikaelson' }}">
  <meta property="og:description" content="{{ description or 'Software engineer. Building things with care.' }}">
  <meta property="og:type" content="website">
  <title>{% if title %}{{ title }} — {% endif %}Kol Mikaelson</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400;1,700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="grain" aria-hidden="true"></div>

  <header class="nav">
    <div class="container nav__inner">
      <a href="/" class="nav__name">kol mikaelson</a>
      <nav class="nav__links" aria-label="Primary navigation">
