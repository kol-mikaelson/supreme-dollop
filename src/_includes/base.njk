        <a href="https://linkedin.com/in/kol-mikaelson" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">Résumé</a>
      </div>
      <p class="footer__copy">© 2026 Kol Mikaelson</p>
    </div>
